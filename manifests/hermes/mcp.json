{
  "mcpServers": {
    "membase": {
      "command": "npx",
      "args": [
        "-y",
        "@membase/mcp-server"
      ],
      "env": {
        "MEMBASE_API_BASE_URL": "https://api.membase.com",
        "MEMBASE_API_KEY": "${MEMBASE_API_KEY}",
        "MEMBASE_CLIENT_ID": "hermes",
        "MEMBASE_CLIENT_NAME": "Hermes Agent",
        "MEMBASE_CLIENT_VERSION": "0.0.0"
      }
    }
  }
}
