{
  "description": "Membase automatic recall and summary capture. One hooks file serves every stdio host (Claude Code, Codex, Cursor): the hook runtime detects the host at startup \u2014 MEMBASE_CLIENT_SOURCE override, then Cursor payload fields, then CODEX_PLUGIN_ROOT \u2014 and skips events the detected host doesn't own (Claude captures via PostToolBatch, Codex/Cursor via PostToolUse), so registering both here never double-captures. PostToolUse/Stop/SessionEnd carry no `async` flag on purpose: Codex parses but does not support async and SKIPS such handlers (capture would silently die there); the Claude-only events (PostToolBatch, PreCompact, PostCompact) keep async for UI latency. Installers (e.g. the plugins CLI) may rewrite CLAUDE_PLUGIN_ROOT to the host's own plugin-root variable; Codex itself exposes PLUGIN_ROOT plus a CLAUDE_PLUGIN_ROOT compat alias.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs UserPromptSubmit",
            "timeout": 4
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs PostToolBatch",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Bash|Task|Agent|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs PostToolUse",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs Stop",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs PreCompact",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs PostCompact",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs SessionEnd",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
