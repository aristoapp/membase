{
  "description": "Membase automatic recall and summary capture. One hooks file serves every stdio host (Claude Code, Codex, Cursor): the hook runtime detects the host at startup — MEMBASE_CLIENT_SOURCE override, then Cursor payload fields, then CODEX_PLUGIN_ROOT — and skips events the detected host doesn't own (Claude captures via PostToolBatch, Codex/Cursor via PostToolUse), so registering both here never double-captures. Installers (e.g. the plugins CLI) may rewrite CLAUDE_PLUGIN_ROOT to the host's own plugin-root variable.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs UserPromptSubmit",
            "timeout": 4
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs PostToolBatch",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Bash|Task|Agent|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs PostToolUse",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs Stop",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs PreCompact",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs PostCompact",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ${CLAUDE_PLUGIN_ROOT}/hooks/hook.cjs SessionEnd",
            "async": true,
            "timeout": 20
          }
        ]
      }
    ]
  }
}
