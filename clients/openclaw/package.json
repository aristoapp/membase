{
  "name": "@membase/client-openclaw",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@membase/connector-sdk": "workspace:*",
    "@membase/plugin-core": "workspace:*"
  },
  "exports": {
