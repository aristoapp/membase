{
  "$comment": "Language-neutral golden vectors binding capture-core/src/handoff.ts and the Hermes Python port clients/hermes/python/src/membase_hermes/handoff.py. Both test suites consume this file so tag/clamp/picker/sweep-selection drift fails CI. Bundle cases carry bare episode fields; each language wraps them in its bundle shape and asserts by index (picked_index / selected_indexes refer to input order).",
  "recall_query": {
    "out": "[HANDOFF] session handoff summary"
  },
  "handoff_memory": {
    "$comment": "buildHandoffMemory / build_handoff_memory — tag + optional (project) scope, trimmed.",
    "cases": [
      {
        "summary": "wrap up state",
        "out": "[HANDOFF] wrap up state"
      },
      {
        "summary": "  padded  ",
        "out": "[HANDOFF] padded"
      },
      {
        "summary": "scoped state",
        "project": "proj-a",
        "out": "[HANDOFF] (proj-a) scoped state"
      },
      {
        "summary": "scoped state",
        "project": "  proj-a  ",
        "out": "[HANDOFF] (proj-a) scoped state"
      },
      {
        "summary": "state",
        "project": "   ",
        "out": "[HANDOFF] state"
      }
    ]
  },
  "handoff_display_summary": {
    "$comment": "buildHandoffDisplaySummary / build_handoff_display_summary — summary clamped to 400 chars BEFORE tagging (backend display_summary limit is 500).",
    "cases": [
      {
        "summary": "short",
        "project": "proj-a",
        "out": "[HANDOFF] (proj-a) short"
      },
      {
        "summary": "",
        "project": "proj-a",
        "out": "[HANDOFF] (proj-a) "
      },
      {
        "summary": "    ",
        "out": "[HANDOFF] "
      }
    ]
  },
  "is_handoff_memory": {
    "$comment": "isHandoffMemory / is_handoff_memory — literal prefix after leading-whitespace trim, case-sensitive.",
    "cases": [
      {
        "in": "[HANDOFF] state",
        "is_handoff": true
      },
      {
        "in": "   [HANDOFF] leading spaces",
        "is_handoff": true
      },
      {
        "in": "\t[HANDOFF] tab",
        "is_handoff": true
      },
      {
        "in": "[HANDOFF] (proj-a) scoped",
        "is_handoff": true
      },
      {
        "in": "HANDOFF no brackets",
        "is_handoff": false
      },
      {
        "in": "[handoff] lower",
        "is_handoff": false
      },
      {
        "in": "we chose postgres",
        "is_handoff": false
      },
      {
        "in": "",
        "is_handoff": false
      }
    ]
  },
